# Copy to .env (NEVER commit .env). Use a THROWAWAY testnet wallet only.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
DEPLOYER_PRIVATE_KEY=
ETHERSCAN_API_KEY=
# Comma-separated founding members (at least 3, all different, none zero).
FOUNDERS=0xAAA...,0xBBB...,0xCCC...
# Optional (defaults shown)
VOTING_PERIOD_SECONDS=86400
MAX_SPEND_BPS=5000
